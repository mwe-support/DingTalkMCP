# MWE审批MCP enterprise internal application credentials.
DINGTALK_CLIENT_ID=dingxxxxxxxxxxxxxxxx
DINGTALK_CLIENT_SECRET=replace-in-secret-store
DINGTALK_CORP_ID=ding-corp-id
DINGTALK_AGENT_ID=
DINGTALK_API_BASE_URL=https://api.dingtalk.com
DINGTALK_APPROVAL_EVENTS_ENABLED=true

# Canonical self-hosted OAuth/MCP URLs. All three URLs must share one HTTPS origin.
MCP_PUBLIC_URL=https://dingtalk.mwexk.com/mcp
MCP_ISSUER_URL=https://dingtalk.mwexk.com/
DINGTALK_OAUTH_REDIRECT_URL=https://dingtalk.mwexk.com/oauth/dingtalk/callback

# Ed25519 PKCS#8 private key. Mount this file read-only; never commit it.
MCP_SIGNING_PRIVATE_KEY_FILE=/run/secrets/mcp-signing-private.pem
MCP_AUDIT_HMAC_KEY_FILE=/run/secrets/mcp-audit-hmac.key
MCP_SIGNING_KEY_ID=mwe-approval-mcp-1
MCP_ACCESS_TOKEN_TTL_SECONDS=600
MCP_REFRESH_TOKEN_TTL_SECONDS=604800
MCP_AUTH_TRANSACTION_TTL_SECONDS=300
MCP_ALLOWED_SCOPES=approval:read,approval:decide,approval:create
MCP_AUTH_STORE_PATH=/app/data/auth

# Optional extra processCode allowlist for compatibility APIs. approval_request always uses its built-in exact allowlist.
APPROVAL_ALLOWED_PROCESS_CODES=
APPROVAL_IDEMPOTENCY_LEDGER_PATH=/app/data/approval-idempotency
APPROVAL_AUDIT_LOG_PATH=/app/data/audit
APPROVAL_INBOX_PATH=/app/data/approval-inbox

# Allowed host suffixes for temporary attachment links returned to the Agent client.
APPROVAL_DOWNLOAD_HOST_SUFFIXES=.dingtalk.com,.alicdn.com,.aliyuncs.com
# Direct-upload URLs returned to the Agent client must match this HTTPS suffix allowlist.
APPROVAL_UPLOAD_HOST_SUFFIXES=.trans.dingtalk.com,.aliyuncs.com

# Node listens behind the CVM TLS ingress. Only the listed public Host is accepted.
APPROVAL_BACKEND_HOST=0.0.0.0
APPROVAL_BACKEND_PORT=3000
APPROVAL_BACKEND_ALLOWED_HOSTS=dingtalk.mwexk.com
APPROVAL_HOST_PORT=3000
