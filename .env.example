DINGTALK_CLIENT_ID=dingxxxxxxxxxxxxxxxx
DINGTALK_CLIENT_SECRET=replace-in-secret-store
DINGTALK_API_BASE_URL=https://api.dingtalk.com

# This server credential represents exactly one DingTalk user for mutations
# and attachment authorization. Do not accept a caller userId from untrusted input.
DINGTALK_CALLER_USER_ID=

# Comma-separated DingTalk userIds authorized for write tools.
# When empty, all approval mutations remain disabled.
DINGTALK_WRITE_USER_IDS=

# Optional comma-separated processCode allowlist. Empty means no template filter.
APPROVAL_ALLOWED_PROCESS_CODES=

# Persist creation outcomes across restarts. The container example mounts /app/data.
APPROVAL_IDEMPOTENCY_LEDGER_PATH=./data/approval-idempotency

# Attachment response guardrails.
APPROVAL_DOWNLOAD_MAX_BYTES=10485760
APPROVAL_DOWNLOAD_HOST_SUFFIXES=.dingtalk.com,.alicdn.com,.aliyuncs.com

# Streamable HTTP transport. Loopback is the secure default.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_API_KEY=
MCP_HTTP_ALLOWED_HOSTS=

# Bearer key used only by DingTalk MCP Platform when it calls the ordinary
# HTTPS tool actions under /platform/tools/<toolName>. Leave empty to disable.
MCP_PLATFORM_API_KEY=
