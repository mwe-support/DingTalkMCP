{
  "name": "@mwe/dingtalk-approval-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Independent DingTalk OA approval MCP server for MWE.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:http": "tsx src/transports/http.ts",
    "dev:stdio": "tsx src/transports/stdio.ts",
    "start:http": "node dist/transports/http.js",
    "start:stdio": "node dist/transports/stdio.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
