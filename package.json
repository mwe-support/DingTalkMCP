{
  "name": "@mwe/dingtalk-approval-mcp",
  "version": "0.6.0",
  "private": true,
  "description": "Self-hosted OAuth-protected Streamable HTTP MCP for DingTalk OA approvals.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "dev:http": "tsx src/transports/http.ts",
    "start:http": "node dist/transports/http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "jose": "6.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.3.0",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
